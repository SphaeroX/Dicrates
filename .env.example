# Copy this file to .env and fill in the real values there.
# .env is git-ignored and must never be committed.
# The backend reads these variables; the Flutter app only gets the public
# Supabase values via --dart-define (never the service role key).

# Mistral (EU) - LLM provider for summaries, evaluation, content filter.
# Get a key at https://console.mistral.ai/ . Required for backend LLM features.
MISTRAL_API_KEY=

# Supabase project (EU region) - Auth and Postgres.
# Project URL, e.g. https://<project-ref>.supabase.co . Required.
SUPABASE_URL=
# Public anon/publishable key. Safe for the app. Required.
SUPABASE_ANON_KEY=
# Service role/secret key. Backend only, bypasses RLS. Required.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to verify Supabase access tokens in the API. Required.
SUPABASE_JWT_SECRET=

# Postgres connection string (Supabase pooler or local `supabase start`).
# Used by the API and the Procrastinate job worker. Required.
DATABASE_URL=

# Firebase Cloud Messaging - push notifications (Android + iOS via APNs).
# Firebase project id. Optional until push is implemented.
FCM_PROJECT_ID=
# Path to the Firebase service account JSON (kept outside the repo or git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=
