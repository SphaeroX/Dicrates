# Copy this file to .env and fill in the real values there.
# .env is git-ignored and must never be committed.
# The backend reads these variables; the Flutter app only gets the public
# Supabase values via --dart-define (never the service role key).

# LLM model for all LLM calls (summaries, evaluation, content filter), as a
# Pydantic AI model string "<provider>:<model>". Switching provider = changing
# this value (plus that provider's key below). Default mistral:mistral-large-latest.
# Production must use a "mistral:" model (EU processing, GDPR Art. 9); the
# backend refuses any other provider when APP_ENV=production.
# Dev example with Gemini: LLM_MODEL=google:gemini-3.8-flash
LLM_MODEL=mistral:mistral-large-latest

# Mistral (EU) - production LLM provider.
# Get a key at https://console.mistral.ai/ . Required for "mistral:" models.
MISTRAL_API_KEY=

# Google Gemini API - DEV ONLY, never with real user data (not EU-bound;
# free-tier requests may be used by Google for training).
# Get a key at https://aistudio.google.com/apikey . Required for "google:" models.
GOOGLE_API_KEY=

# Runtime environment: "development" or "production". Default "development".
APP_ENV=development

# Supabase project (EU region) - Auth and Postgres.
# Project URL, e.g. https://<project-ref>.supabase.co . Required.
SUPABASE_URL=
# Public anon/publishable key. Safe for the app. Required.
SUPABASE_ANON_KEY=
# Service role/secret key. Backend only, bypasses RLS. Required.
# (Access tokens are verified against the project JWKS at
# $SUPABASE_URL/auth/v1/.well-known/jwks.json, so no JWT secret is needed.)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Supabase pooler or local `supabase start`).
# Used by the API and the Procrastinate job worker. Required.
# Local stack (`npx supabase start`): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Firebase Cloud Messaging - push notifications (Android + iOS via APNs).
# Firebase project id. Optional until push is implemented.
FCM_PROJECT_ID=
# Path to the Firebase service account JSON (kept outside the repo or git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=

# Google sign-in for the LOCAL Supabase stack (supabase/config.toml reads these
# when [auth.external.google] enabled = true). Create an OAuth client of type
# "Web application" in the Google Cloud console with the redirect URI
# http://127.0.0.1:54321/auth/v1/callback . For the cloud project, configure
# Google in the Supabase dashboard instead. Optional.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- App (Flutter) build-time values, passed with --dart-define, not read from .env ---
# API_BASE_URL       backend URL (Android emulator: http://10.0.2.2:8000)
# SUPABASE_URL       same as above (local: http://10.0.2.2:54321 from the emulator)
# SUPABASE_ANON_KEY  public anon/publishable key
# ENABLE_APPLE_SIGN_IN=true  only once an Apple Developer account exists
